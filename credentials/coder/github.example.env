# Copy to github.env. From the coder's GitHub App.
# Save the app's private key next to this file as github-app.pem; Compose mounts it
# as the github_app_key secret at /run/secrets/github_app_key, never as an env var.
# Until the GitHub App exists, `touch github-app.pem` so Compose can start.
GITHUB_APP_ID=
GITHUB_INSTALLATION_ID=
# Commits are authored as <slug>[bot].
GITHUB_APP_SLUG=
