# Copy to linear.env. From the coder's Linear OAuth app (Settings → API → Applications).
LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=
LINEAR_WEBHOOK_SECRET=
# The coder's tunnel hostname, no trailing slash, e.g. https://coder.agents.example.com.
# The OAuth redirect URI is <PUBLIC_URL>/oauth/callback; the webhook URL is <PUBLIC_URL>/webhooks/linear.
# Once the stack is up, open <PUBLIC_URL>/oauth/install and approve to install the coder.
# Its tokens are kept on the data volume at /data/linear/tokens.json.
PUBLIC_URL=
