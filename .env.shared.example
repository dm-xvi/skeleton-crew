# Copy to .env.shared. Shared by every role's bridge.
# The token comes from `claude setup-token` (a Pro/Max subscription) and lasts one year.
# Leave ANTHROPIC_API_KEY and ANTHROPIC_AUTH_TOKEN out: either one outranks the token and bills the API.
CLAUDE_CODE_OAUTH_TOKEN=
# Optional: fatal, error, warn, info, debug or trace. Defaults to info, or to trace
# when NODE_ENV=development. Set NODE_ENV=development here to log everything while developing.
# LOG_LEVEL=info
