# Secrets and runtime state never go in git.
data/

# Real env files are ignored everywhere; example templates are committed.
.env
.env.*
*.env
!.env.example
!.env.shared.example
!*.example.env

# Build output.
node_modules/
dist/

# Everything under credentials/ is secret except example env files.
credentials/**
!credentials/**/
!credentials/**/*.example.env
